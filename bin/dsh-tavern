#!/bin/sh

set -eu

TAVERN_PROFILE=tavern
DSH_ROOT="${DSH_HOME:-${HOME}/.dsh}"
TAVERN_PROFILE_DIR="${DSH_ROOT}/profiles/${TAVERN_PROFILE}"
TAVERN_LOG_DIR="${DSH_ROOT}/logs"
TAVERN_LOG_FILE="${TAVERN_LOG_DIR}/tavern.log"

resolve_script_path() {
  SCRIPT_PATH=$0
  while [ -L "${SCRIPT_PATH}" ]; do
    SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd)
    SCRIPT_LINK=$(readlink "${SCRIPT_PATH}")
    case "${SCRIPT_LINK}" in
      /*) SCRIPT_PATH=${SCRIPT_LINK} ;;
      *) SCRIPT_PATH=${SCRIPT_DIR}/${SCRIPT_LINK} ;;
    esac
  done
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd)
  SCRIPT_PATH=${SCRIPT_DIR}/$(basename -- "${SCRIPT_PATH}")
  SOURCE_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)
}

resolve_script_path

profile_port() {
  awk '$1 == "port:" { print $2; exit }' "${TAVERN_PROFILE_DIR}/cordis.patch.yml" 2>/dev/null || true
}

TAVERN_PORT=$(profile_port)
TAVERN_PORT=${TAVERN_PORT:-3081}

listener_pids() {
  lsof -tiTCP:"${TAVERN_PORT}" -sTCP:LISTEN 2>/dev/null || true
}

resolve_dsh() {
  DSH_BIN=$(command -v dsh 2>/dev/null || true)
  if [ -z "${DSH_BIN}" ]; then
    DSH_BIN=$(ls -t "${HOME}"/.nvm/versions/node/*/bin/dsh 2>/dev/null | head -n 1 || true)
  fi
  if [ -z "${DSH_BIN}" ] || [ ! -x "${DSH_BIN}" ]; then
    echo "找不到 dsh，请先安装 DeepSeek Harness 并确保 dsh 在 PATH 中。" >&2
    exit 1
  fi
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "缺少命令：$1" >&2
    exit 1
  fi
}

verify_source() {
  for SOURCE_FILE in package.json cordis.patch.yml pnpm-workspace.yaml tavern-plugin/package.json presets/tavern/preset.yml; do
    if [ ! -f "${SOURCE_ROOT}/${SOURCE_FILE}" ]; then
      echo "安装源不完整，缺少：${SOURCE_ROOT}/${SOURCE_FILE}" >&2
      exit 1
    fi
  done
}

write_profile_manifest() {
  node - "${SOURCE_ROOT}" "${TAVERN_PROFILE_DIR}" <<'NODE'
const fs = require('node:fs')
const path = require('node:path')

const sourceRoot = process.argv[2]
const profileDir = process.argv[3]
const source = JSON.parse(fs.readFileSync(path.join(sourceRoot, 'package.json'), 'utf8'))
const targetPath = path.join(profileDir, 'package.json')
let current = {}

if (fs.existsSync(targetPath)) {
  current = JSON.parse(fs.readFileSync(targetPath, 'utf8'))
  if (current.name && current.name !== 'dsh-profile-tavern') {
    throw new Error(`目标 profile 已属于其他项目：${current.name}`)
  }
}

const dependencies = {
  ...(current.dependencies || {}),
  'dsh-codex-connect': source.dependencies['dsh-codex-connect'],
  'dsh-tavern-plugin': `link:${path.join(sourceRoot, 'tavern-plugin')}`,
}
delete dependencies['@deepseek-ai/dsh-tools']
const next = {
  ...current,
  name: 'dsh-profile-tavern',
  private: true,
  dependencies,
  dsh: source.dsh,
  dshTavern: { source: sourceRoot },
}
const temporary = `${targetPath}.tmp-${process.pid}`
fs.writeFileSync(temporary, `${JSON.stringify(next, null, 2)}\n`)
fs.renameSync(temporary, targetPath)
NODE
}

install_command() {
  BIN_DIR=${DSH_TAVERN_BIN_DIR:-${HOME}/.local/bin}
  COMMAND_PATH=${BIN_DIR}/dsh-tavern
  mkdir -p "${BIN_DIR}"

  if [ -L "${COMMAND_PATH}" ] && [ "$(readlink "${COMMAND_PATH}")" = "${SCRIPT_PATH}" ]; then
    return
  fi
  if [ -e "${COMMAND_PATH}" ] || [ -L "${COMMAND_PATH}" ]; then
    BACKUP_PATH=${COMMAND_PATH}.backup.$(date +%Y%m%d%H%M%S)
    mv "${COMMAND_PATH}" "${BACKUP_PATH}"
    echo "已备份原命令：${BACKUP_PATH}"
  fi
  ln -s "${SCRIPT_PATH}" "${COMMAND_PATH}"
  echo "已安装命令：${COMMAND_PATH}"

  case ":${PATH}:" in
    *":${BIN_DIR}:"*) ;;
    *) echo "提示：请把 ${BIN_DIR} 加入 PATH，然后重新打开终端。" ;;
  esac
}

install_profile() {
  resolve_dsh
  require_command node
  require_command pnpm
  require_command lsof
  verify_source

  mkdir -p "${TAVERN_PROFILE_DIR}" "${TAVERN_LOG_DIR}"
  mkdir -p "${SOURCE_ROOT}/data/cards" "${SOURCE_ROOT}/data/chats" "${SOURCE_ROOT}/data/scripts" "${SOURCE_ROOT}/data/sources" "${SOURCE_ROOT}/data/diffs"
  pnpm --dir "${SOURCE_ROOT}/tavern-plugin" install --ignore-workspace
  write_profile_manifest
  cp "${SOURCE_ROOT}/cordis.patch.yml" "${TAVERN_PROFILE_DIR}/cordis.patch.yml"
  cp "${SOURCE_ROOT}/pnpm-workspace.yaml" "${TAVERN_PROFILE_DIR}/pnpm-workspace.yaml"
  pnpm --dir "${TAVERN_PROFILE_DIR}" install
  "${DSH_BIN}" --profile "${TAVERN_PROFILE}" --dump-config >/dev/null
  install_command

  echo "DSH Tavern 已安装。"
  echo "启动：dsh-tavern start"
}

verify_profile() {
  if [ ! -f "${TAVERN_PROFILE_DIR}/package.json" ] || [ ! -f "${TAVERN_PROFILE_DIR}/cordis.patch.yml" ]; then
    echo "DSH Tavern 尚未安装，请先运行：${SCRIPT_PATH} install" >&2
    exit 1
  fi
}

verify_tavern_pids() {
  SERVICE_PIDS=$(listener_pids)
  for SERVICE_PID in ${SERVICE_PIDS}; do
    SERVICE_COMMAND=$(ps -p "${SERVICE_PID}" -o command= 2>/dev/null || true)
    case "${SERVICE_COMMAND}" in
      *"dsh --profile ${TAVERN_PROFILE}"*) ;;
      *)
        echo "端口 ${TAVERN_PORT} 被其他进程占用，拒绝操作：${SERVICE_COMMAND}" >&2
        exit 1
        ;;
    esac
  done
}

status_service() {
  verify_profile
  require_command lsof
  verify_tavern_pids
  if [ -z "${SERVICE_PIDS}" ]; then
    echo "DSH Tavern 未运行（端口 ${TAVERN_PORT}）。"
    return 1
  fi
  echo "DSH Tavern 正在运行：PID ${SERVICE_PIDS}，http://127.0.0.1:${TAVERN_PORT}"
}

stop_service() {
  verify_profile
  require_command lsof
  verify_tavern_pids
  if [ -z "${SERVICE_PIDS}" ]; then
    echo "DSH Tavern 已停止。"
    return 0
  fi

  kill -TERM ${SERVICE_PIDS}
  WAIT_COUNT=0
  while [ "${WAIT_COUNT}" -lt 100 ] && [ -n "$(listener_pids)" ]; do
    sleep 0.1
    WAIT_COUNT=$((WAIT_COUNT + 1))
  done
  if [ -n "$(listener_pids)" ]; then
    echo "服务未能在 10 秒内停止；没有强制杀进程，请手动检查。" >&2
    exit 1
  fi
  echo "DSH Tavern 已停止。"
}

start_service() {
  verify_profile
  require_command lsof
  verify_tavern_pids
  if [ -n "${SERVICE_PIDS}" ]; then
    echo "DSH Tavern 已经在运行：PID ${SERVICE_PIDS}。"
    return 0
  fi

  resolve_dsh
  mkdir -p "${TAVERN_LOG_DIR}"
  nohup "${DSH_BIN}" --profile "${TAVERN_PROFILE}" >>"${TAVERN_LOG_FILE}" 2>&1 </dev/null &
  START_PID=$!

  WAIT_COUNT=0
  while [ "${WAIT_COUNT}" -lt 150 ]; do
    if [ -n "$(listener_pids)" ]; then
      echo "DSH Tavern 已启动：PID $(listener_pids)，http://127.0.0.1:${TAVERN_PORT}"
      echo "日志：${TAVERN_LOG_FILE}"
      return 0
    fi
    if ! kill -0 "${START_PID}" 2>/dev/null; then
      echo "DSH Tavern 启动失败，最近日志如下：" >&2
      tail -n 30 "${TAVERN_LOG_FILE}" >&2 || true
      exit 1
    fi
    sleep 0.2
    WAIT_COUNT=$((WAIT_COUNT + 1))
  done

  echo "DSH Tavern 启动超时，日志：${TAVERN_LOG_FILE}" >&2
  exit 1
}

usage() {
  echo "用法：dsh-tavern {install|start|stop|restart|status}"
}

ACTION=${1:-status}
case "${ACTION}" in
  install) install_profile ;;
  start) start_service ;;
  stop) stop_service ;;
  restart)
    stop_service
    start_service
    echo "浏览器旧页面仍会保留旧版前端；代码更新后请按 Cmd+Shift+R 强制刷新。"
    ;;
  status) status_service ;;
  -h|--help|help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
