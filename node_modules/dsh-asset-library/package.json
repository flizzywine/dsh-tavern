{
  "name": "dsh-asset-library",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./asset-packs": {
      "types": "./lib/asset-packs/index.d.ts",
      "default": "./lib/asset-packs/index.js"
    },
    "./pack-service": {
      "types": "./lib/pack-v2/service.d.ts",
      "default": "./lib/pack-v2/service.js"
    },
    "./pack-settings": {
      "types": "./lib/pack-v2/native-settings.d.ts",
      "default": "./lib/pack-v2/native-settings.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "dependencies": {
    "sharp": "0.34.5"
  }
}
