let pass = 0, fail = 0
function ok(label, condition, detail) {
  if (condition) { pass++; console.log('  PASS  ' + label) }
  else { fail++; console.log('  FAIL  ' + label + (detail === undefined ? '' : '  → ' + detail)) }
}
function throws(label, fn, expect) {
  try { fn(); ok(label, false, '未抛错') } catch (error) { ok(label, !expect || error.message.includes(expect), error.message) }
}
function novelai(extra = {}) {
  return channelSettings({ provider: 'novelai', baseURL: 'https://image.novelai.net', model: 'nai-diffusion-5-full', size: '832x1216', ...extra })
}

