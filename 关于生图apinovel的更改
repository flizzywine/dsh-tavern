### 功能测试

```js
// 1) 独立字段正常解析
channelSettings({ provider:'novelai', baseURL:'...', model:'...', size:'...', qualityTags:'test' })
// → qualityTags='test'

// 2) promptOrder 排列校验
channelSettings({ ..., promptOrder:'artist,quality,scene,style' })  // ✓
channelSettings({ ..., promptOrder:'artist,artist,scene,style' })    // ✗ 重复
channelSettings({ ..., promptOrder:'artist,scene' })                  // ✗ 不完整

// 3) sectionWeights 校验
channelSettings({ ..., sectionWeights:'1.5,1,1,0.75' })              // ✓
channelSettings({ ..., sectionWeights:'1.5,0' })                     // ✗ 非正数

// 4) seed 范围校验
channelSettings({ ..., seed:'12345' })                               // ✓
channelSettings({ ..., seed:'-1' })                                  // ✗ 负数
channelSettings({ ..., seed:'99999999999' })                         // ✗ 超大

// 5) promptPresets JSON 校验
channelSettings({ ..., promptPresets:'{"name":{"qualityTags":"test"}}' })  // ✓
channelSettings({ ..., promptPresets:'not json' })                          // ✗

// 6) referenceImage 正常存储
channelSettings({ ..., referenceImage:'data:image/png;base64,abc' })        // ✓
```

### 提示词组装验证

```js
// 默认顺序（无 promptOrder）
// qualityTags='masterpiece', artistString='artist:wlop', scene='1girl', style='anime'
// → "masterpiece, 1girl, anime, artist:wlop"

// 自定义顺序
// promptOrder='artist,quality,scene,style'
// → "artist:wlop, masterpiece, 1girl, anime"

// 段权重
// sectionWeights='1.5,1,1,0.75', promptOrder='quality,scene,style,artist'
// → "{{masterpiece}}, 1girl, anime, {artist:wlop}"

// 通配符
// qualityTags='{studio light|golden hour}'
// → "studio light, ..." 或 "golden hour, ..."（每次随机）

// 权重语法保留
// qualityTags='{masterpiece}'
// → "{masterpiece}, ..."（NovelAI 弱化权重，原样传递）
```

