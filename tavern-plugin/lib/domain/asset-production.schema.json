{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-assets:project:2",
  "$comment": "v1.1 portable authoring project, independent of runtime pack schema",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "revision", "characters", "assets", "slots", "plans", "reviews"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type":"string", "pattern":"^[0-9a-f-]{36}$"},
    "name": {"type":"string", "maxLength":4000},
    "revision": {"type":"integer", "minimum":0},
    "characters": {"type":"array", "maxItems":64, "items":{"type":"object", "required":["key","id","name","outfits"], "properties":{"key":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"emotions":{"type":"array","maxItems":256,"items":{"type":"object","required":["id"],"properties":{"id":{"type":"string"},"label":{"type":"string","minLength":1,"maxLength":6}},"$comment":"A sole {id} entry is a single image, not a variant; native validateFigureEmotions enforces exclusivity and fields."}},"avatarFraming":{"$ref":"#/$defs/avatarFraming"},"heightCm":{"type":"number","minimum":0},"heightConfirmed":{"type":"boolean"},"outfits":{"type":"array","items":{"type":"object","properties":{"status":{"enum":["missing"]}}}}}}},
    "addedFigures": {"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["operationId","revision","added"],"properties":{"operationId":{"type":"string","pattern":"^[0-9a-f-]{36}$"},"revision":{"type":"integer","minimum":1},"added":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["key","id","authoringKey","slot","expected_version"],"properties":{"key":{"type":"string"},"id":{"type":"string"},"authoringKey":{"type":"string"},"slot":{"type":"string"},"expected_version":{"const":0}}}}}}},
    "assets": {"type":"array"},
    "slots": {"type":"object", "maxProperties":16384, "additionalProperties":{"$ref":"#/$defs/slot"}},
    "plans": {"type":"object", "maxProperties":65536},
    "restoredReplacements": {"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["slotHash","canonicalFraming","sourceFraming","revision"],"properties":{"slotHash":{"$ref":"#/$defs/hash"},"canonicalFraming":{},"sourceFraming":{},"revision":{"type":"string"}}}},
    "workflowWaits": {"type":"object","additionalProperties":{"type":"object","required":["on","reason","timestamp"],"additionalProperties":false,"properties":{"on":{"type":"string","minLength":1,"maxLength":300},"reason":{"type":"string","minLength":1,"maxLength":1000},"timestamp":{"type":"string"}}}},
    "mouthSources": {"type":"object","maxProperties":4096,"additionalProperties":{"type":"object","additionalProperties":false,"required":["slot","version","hash","path","width","height","nativeRevision","mouth"],"properties":{"slot":{"type":"string"},"version":{"type":["integer","string"],"minimum":0},"hash":{"$ref":"#/$defs/hash"},"path":{"$ref":"#/$defs/path"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"nativeRevision":{"type":"string","minLength":1},"mouth":{},"atlasPath":{"$ref":"#/$defs/path"},"routing":{"type":"string"},"route":{"enum":["static","layered","parts"]}}}},
    "blinkSources": {"type":"object","maxProperties":4096,"additionalProperties":{"type":"object","additionalProperties":false,"required":["slot","version","hash","path","width","height","nativeRevision","mouth"],"properties":{"slot":{"type":"string"},"version":{"type":["integer","string"],"minimum":0},"hash":{"$ref":"#/$defs/hash"},"path":{"$ref":"#/$defs/path"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"nativeRevision":{"type":"string","minLength":1},"mouth":{},"atlasPath":{"$ref":"#/$defs/path"},"routing":{"type":"string"},"route":{"enum":["static","layered","parts"]}}}},
    "mouthOrders": {"type":"object","additionalProperties":{"const":"closed,small,mid,open"}},
    "baseline": {"type":"object","additionalProperties":false,"required":["scope","packId","nativeRevision","contentHash","uuidMap","sources"],"properties":{
      "scope":{"enum":["settei","images"]},"packId":{"type":"string","pattern":"^[0-9a-f-]{36}$"},"nativeRevision":{"type":"string","minLength":1},"contentHash":{"$ref":"#/$defs/hash"},
      "metadataSources":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","nativePath"],"properties":{"path":{"$ref":"#/$defs/path"},"nativePath":{"$ref":"#/$defs/path"}}}},
      "uuidMap":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["key","id","outfits"],"properties":{"key":{"type":"string"},"id":{"type":"string"},"outfits":{"type":"array","items":{"type":"string"}}}}},
      "sources":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["slot","hash","path","nativePath"],"properties":{"slot":{"type":"string"},"hash":{"$ref":"#/$defs/hash"},"path":{"$ref":"#/$defs/path"},"nativePath":{"$ref":"#/$defs/path"},"version":{"type":"string"},"parentVersion":{"type":"string"},"palette":{"type":"array","items":{"$ref":"#/$defs/palette"}}}}}
    }},
    "reviews": {"type":"array"}
  },
  "$defs": {
    "mouthBinding": {"type":"object","additionalProperties":false,"required":["slot","version","hash"],"properties":{"slot":{"type":"string"},"version":{"type":["integer","string"],"minimum":0},"hash":{"$ref":"#/$defs/hash"}}},
    "avatarFraming":{"type":"object","additionalProperties":false,"required":["mode","reference","tolerance"],"properties":{"mode":{"const":"match-reference"},"reference":{"const":"installed-default"},"tolerance":{"const":0.03}}},
    "hash": {"type":"string", "pattern":"^[0-9a-f]{64}$"},
    "path": {"type":"string", "pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "quad": {"type":"array", "minItems":4,"maxItems":4,"items":{"type":"integer","minimum":0}},
    "pair": {"type":"array", "minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},
    "evidenceKind": {"enum":["observed","inferred","reconstructed"]},
    "approval": {"type":"object", "required":["status"], "properties":{"status":{"enum":["missing","blocked","changed","pending","approved","refused"]},"reviewer":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"timestamp":{"type":"string"}}},
    "source": {"type":"object", "required":["source_id","path","source_hash"], "properties":{"source_id":{"type":"string"},"path":{"$ref":"#/$defs/path"},"source_hash":{"$ref":"#/$defs/hash"},"notes":{"type":"string"}}},
    "block": {"type":"object", "required":["source_id","source_hash","crop_ltrb","layout_xywh","native_size","reference_role","evidence_kind"], "properties":{"source_id":{"type":"string"},"source_hash":{"$ref":"#/$defs/hash"},"crop_ltrb":{"$ref":"#/$defs/quad"},"layout_xywh":{"$ref":"#/$defs/quad"},"native_size":{"$ref":"#/$defs/pair"},"reference_role":{"type":"string"},"evidence_kind":{"$ref":"#/$defs/evidenceKind"},"notes":{"type":"string"}}},
    "palette": {"type":"object", "required":["role","hex","zone"],"properties":{"role":{"type":"string","minLength":1},"hex":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},"zone":{"type":"string","minLength":1},"source_id":{"type":"string"},"sample_xy":{"$ref":"#/$defs/pair"},"lighting":{"type":"string"},"evidence_kind":{"$ref":"#/$defs/evidenceKind"}}},
    "settei": {"type":"object", "properties":{"character_id":{"type":"string"},"work_version":{"type":"string"},"look_version":{"type":"string"},"parent_version":{"type":"string"},"board_path":{"$ref":"#/$defs/path"},"board_hash":{"$ref":"#/$defs/hash"},"approval":{"$ref":"#/$defs/approval"},"referenced_sources":{"type":"array","items":{"$ref":"#/$defs/source"}},"shown_sources":{"type":"array","items":{"type":"string"}},"blocks":{"type":"array","items":{"$ref":"#/$defs/block"}},"ruler":{"type":"object","properties":{"definition":{"type":"string"},"head_top":{"type":"number"},"chin":{"type":"number"},"sole":{"type":"number"},"occlusion_notes":{"type":"string"}}},"head_angles":{"type":"array","items":{"type":"object","properties":{"angle":{"type":"string"},"left_right_semantics":{"type":"string"},"evidence_kind":{"$ref":"#/$defs/evidenceKind"}}}},"feature_rules":{"type":"array","items":{"type":"string"}},"hair_rules":{"type":"array","items":{"type":"string"}},"palette":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/palette"}},"explicit_differences":{"type":"array","items":{"type":"string"}}}},
    "slot": {"type":"object", "required":["id","kind"], "properties":{"id":{"type":"string"},"kind":{"enum":["identity-settei","settei","sprite","avatar","avatar-sheet","blink","mouth","background","cg"]},"status":{"enum":["missing","blocked","changed","pending","approved","refused","retry-pending","baseline-installed"]},"version":{"type":["integer","string"],"minimum":0},"sourceBinding":{"$ref":"#/$defs/mouthBinding"},"parentVersion":{"type":"string"},"stale":{"type":"boolean"},"settei":{"$ref":"#/$defs/settei"},"palette":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/palette"}},"provenance":{"type":"object","properties":{"source_state_id":{"type":"string"},"prompt_version":{"type":"string"},"references":{"type":"array"},"registration":{"type":"object"},"timestamp":{"type":"string"}}}}}
  }
}
