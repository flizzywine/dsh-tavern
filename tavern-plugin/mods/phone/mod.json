        "title": "外观",
        "fields": [
          "clockText",
          "statusBar",
          "battery",
          "cutout",
          "accentColor",
          "surfaceColor",
          "bodyColor",
          "sound"
        ]
      }
    ]
  },
  "modelSlots": [
    {
      "id": "call",
      "label": "通话模型",
      "purpose": "与联系人进行独立电话对话",
      "kind": "chat",
      "fallback": "foreground",
      "reasoning": "off"
    }
  ]
}
