  "preferences": {
    "schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "defaults": {}
  },
  "dataVersion": 1,
  "assetKinds": [
    {
      "id": "dsh.phone/wallpaper",
      "schemaVersion": 1,
      "directorSelectable": true,
      "schema": {
        "type": "object"
      },
      "label": "手机壁纸"
    }
  ],
  "coreAssets": [
    {
      "id": "device",
      "path": "builtin/device.json"
    },
    {
      "id": "view-html",
      "path": "view/index.html"
    },
    {
      "id": "view-css",
      "path": "view/style.css"
    },
    {
      "id": "view-script",
      "path": "view/index.js"
    },
    {
      "id": "view-battery",
      "path": "view/battery.js"
    },
    {
      "id": "view-dialer",
      "path": "view/dialer.js"
    },
    {
      "id": "view-photos",
      "path": "view/photos.js"
    },
    {
      "id": "tone-drop",
      "path": "view/assets/message.wav"
    },
    {
      "id": "tone-chime",
      "path": "view/assets/chime.wav"
    },
    {
      "id": "tone-pop",
      "path": "view/assets/pop.wav"
    }
  ],
  "permissions": [
    "stage.presentation",
    "source.dialogue",
    "stage.state"
  ],
  "performances": [
    {
      "kind": "dsh.phone.message",
      "autoHold": {
        "minMs": 0,
        "until": "complete"
      },
      "regions": [
        "device"
      ],
      "backlog": {
        "line": {
          "label": "手机",
          "icon": "M8.5 2h7A2.5 2.5 0 0 1 18 4.5v15a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 19.5v-15A2.5 2.5 0 0 1 8.5 2zM8.75 3.75a1 1 0 0 0-1 1v14.5a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1V4.75a1 1 0 0 0-1-1zM10.5 5h3a.6.6 0 0 1 0 1.2h-3a.6.6 0 0 1 0-1.2z",
          "command": "mark",
          "voice": {
            "when": "/form",
            "is": "voice"
          }
        }
      },
      "replay": {
        "stage": true
      }
    }
  ],
  "callVideo": {
    "backdrop": "stage",
    "remote": {
      "head": [0.5, 0.17, 0.32]
    },
    "self": {
      "head": [0.5, 0.2, 0.34]
    }
  },
  "entry": "plugin.mjs",
  "prompts": [
    {
      "id": "rules",
      "model": "director",
      "tag": "mod_phone",
      "slot": "rules.after-core",
      "order": 30,
      "byteBudget": 4096,
      "when": {},
      "markdown": "- A phone message is sent on a device from one person to a recipient or group: SMS, chat-app messages, calls, voice messages. Mark each such paragraph on kind=line, not narration. Cite its at; keep source text unchanged. Holding a phone alone needs no mark.\n- Livestream danmaku and viewer comments, forum or social posts, broadcasts and narration are not phone messages: leave them unmarked in the prose.\n- Infer the channel from surrounding narration: kind=line identifies a speaker, not face-to-face speech. A reply following typing/sending is still a text message; mark its own at. Keep the exchange through intervening narration until the story ends it or returns to in-person speech.\n- Direct: to is the recipient's handle, or $player for the player. The cited line supplies the sender. Mark both directions of NPC and player exchanges, each with its actual recipient. Text uses form=text; calls/voice messages use form=voice.\n- Groups: phone-group defines a stable thread id, name and participants: listed contacts, plus $player when present. Use only source-established members, never the whole contact roster. Use thread instead of to. Reuse a carried group only if its name and members match the source; otherwise create one. Omission keeps groups."
    }
  ],
  "summary": "将剧情中的通话与消息呈现在手机界面中。",
  "commandPrompts": [
    {
      "id": "phone-rule",
      "path": "prompts/phone.txt",
      "placement": {
        "section": "director.rules.presentation",
        "order": 30
      }
    }
  ],
  "commands": [
    {
      "id": "mark",
      "op": "mod.dsh.phone.mark",
      "dsl": {
        "verb": "phone-mark",
        "syntax": "phone-mark mark to=<recipient|$player> form=text|voice; groups: thread=<id> instead of to"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Recipient handle or $player."
          },
          "thread": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Existing group id; replaces to."
          },
          "form": {
            "type": "string",
            "enum": [
              "text",
              "voice"
            ],
            "description": "text 纯文字；voice 语音气泡，按需播放角色配音，可展开原文。由导演按剧情选择。"
          }
        },
        "required": [
          "form"
        ],
        "additionalProperties": false
      },
      "persistence": "marker",
      "handler": "command",
      "promptId": "phone-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 30
      },
      "caps": {
        "perTurn": 40,
        "bytes": 2048
      },
      "mode": "adds"
    },
    {
      "id": "group",
      "op": "mod.dsh.phone.group",
      "dsl": {
        "verb": "phone-group",
        "syntax": "phone-group group thread=<id> name=<title> participants=<JSON array>"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "thread": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "participants": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "required": [
          "thread",
          "name",
          "participants"
        ],
        "additionalProperties": false
      },
      "persistence": "state",
      "handler": "command",
      "promptId": "phone-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 31
      },
      "caps": {
        "perTurn": 8,
        "bytes": 4096
      },
      "mode": "adds"
    }
  ],
  "settingsSchema": {
    "fields": [
      {
        "key": "clockText",
        "type": "text",
        "label": "状态栏文字",
        "default": "09:41",
