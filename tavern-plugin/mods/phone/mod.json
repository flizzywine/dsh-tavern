        "min": 5,
        "max": 100,
        "step": 5,
        "scope": "global",
        "bindable": false
      },
      {
        "key": "cutout",
        "type": "segmented",
        "label": "顶部样式",
        "default": "island",
        "choices": [
          {
            "value": "island",
            "label": "灵动岛"
          },
          {
            "value": "notch",
            "label": "刘海"
          },
          {
            "value": "none",
            "label": "无开孔"
          }
