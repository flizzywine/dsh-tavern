{
  "format": "dsh-mod",
  "schemaVersion": 2,
  "id": "dsh.textcard",
  "name": "文字演出",
  "summary": "导演驱动的物语式文字卡；仅播放一次，完整保留履历",
  "relevance": "情绪转折、强调、回忆、章节切换等适合文字卡演出的时刻",
  "version": "2.0.0",
  "apiVersion": 1,
  "dependencies": {
    "hostApi": 1,
    "capabilities": [
      "stage.place"
    ]
  },
  "permissions": {
    "stage": [
      "place"
    ]
  },
  "commands": [
    {
      "id": "show",
      "op": "text.show",
      "dsl": {
        "verb": "text",
        "syntax": "text show text=\"words\" [preset=word|name|marker|vertical|punct] [sub=\"caption\"] [placement=after|before]"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "description": "Max by preset: word48/name32/marker24/vertical96/punct12."
          },
          "preset": {
            "type": "string",
            "enum": [
              "word",
              "name",
              "marker",
              "vertical",
              "punct"
            ],
            "default": "word"
          },
          "sub": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "placement": {
            "type": "string",
            "enum": [
              "after",
              "before"
            ],
            "default": "after"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "persistence": "event",
      "handler": "command",
      "promptId": "text-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 30
      },
      "caps": {
        "perTurn": 8,
        "bytes": 8192,
        "group": "textcard"
      },
      "mode": "adds"
    },
    {
      "id": "title",
      "op": "mod.dsh.textcard.title",
      "dsl": {
        "verb": "tc-title",
        "syntax": "tc-title title text=\"chapter\" [sub=\"caption\"] [placement=before|after]"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "sub": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "placement": {
            "type": "string",
            "enum": [
              "after",
              "before"
            ],
            "default": "before"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "persistence": "event",
      "handler": "command",
      "promptId": "text-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 31
      },
      "caps": {
        "perTurn": 8,
        "bytes": 8192,
        "group": "textcard"
      },
      "mode": "replaces",
      "replaces": "title.play"
    },
    {
      "id": "sequence",
      "op": "mod.dsh.textcard.sequence",
      "dsl": {
        "verb": "tc-sequence",
        "syntax": "tc-sequence sequence words=[\"word\",...] [kind=echo|signal] [sub=\"caption\"] [placement=after|before]"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "words": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "description": "signal: max24 chars/word."
          },
          "kind": {
            "type": "string",
            "enum": [
              "echo",
              "signal"
            ],
            "default": "echo"
          },
          "sub": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "placement": {
            "type": "string",
            "enum": [
              "after",
              "before"
            ],
            "default": "after"
          }
        },
        "required": [
          "words"
        ],
        "additionalProperties": false
      },
      "persistence": "event",
      "handler": "command",
      "promptId": "text-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 32
      },
      "caps": {
        "perTurn": 8,
        "bytes": 8192,
        "group": "textcard"
      },
      "mode": "adds"
    },
    {
      "id": "count",
      "op": "mod.dsh.textcard.count",
      "dsl": {
        "verb": "tc-count",
        "syntax": "tc-count count from=3 [label=\"deadline\"] [placement=after|before]"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "placement": {
            "type": "string",
            "enum": [
              "after",
              "before"
            ],
            "default": "after"
          }
        },
        "required": [
          "from"
        ],
        "additionalProperties": false
      },
      "persistence": "event",
      "handler": "command",
      "promptId": "text-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 33
      },
      "caps": {
        "perTurn": 8,
        "bytes": 8192,
        "group": "textcard"
      },
      "mode": "adds"
    },
    {
      "id": "relate",
      "op": "mod.dsh.textcard.relate",
      "dsl": {
        "verb": "tc-relate",
        "syntax": "tc-relate relate people=[{id:\"p-01\",name:\"A\"},{id:\"p-02\",name:\"B\"}] links=[{from:\"p-01\",to:\"p-02\",label:\"trust\"}] [heading=\"map\"] [placement=after|before]"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "links": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              },
              "required": [
                "from",
                "to",
                "label"
              ],
              "additionalProperties": false
            },
            "description": "Unique people IDs; endpoints must exist and differ."
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "placement": {
            "type": "string",
            "enum": [
              "after",
              "before"
            ],
            "default": "after"
          }
        },
        "required": [
          "people",
          "links"
        ],
        "additionalProperties": false
      },
      "persistence": "event",
      "handler": "command",
      "promptId": "text-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 34
      },
      "caps": {
        "perTurn": 8,
        "bytes": 8192,
        "group": "textcard"
      },
      "mode": "adds"
    },
    {
      "id": "compare",
      "op": "mod.dsh.textcard.compare",
      "dsl": {
        "verb": "tc-compare",
        "syntax": "tc-compare compare sides=[{name:\"said\",text:\"safe\"},{name:\"thought\",text:\"danger\"}] [topic=\"contrast\"] [placement=after|before]"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "sides": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              },
              "required": [
                "name",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "placement": {
            "type": "string",
            "enum": [
              "after",
              "before"
            ],
            "default": "after"
          }
        },
        "required": [
          "sides"
        ],
        "additionalProperties": false
      },
      "persistence": "event",
      "handler": "command",
      "promptId": "text-rule",
      "placement": {
