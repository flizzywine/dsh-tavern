{
  "name": "dsh-tavern-plugin",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7",
    "chevrotain": "^11.2.0",
    "yaml": "2.9.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
