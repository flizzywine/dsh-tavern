{
  "name": "dsh-tavern-launcher",
  "version": "0.2.0-tavern.17",
  "description": "官方 DeepSeek Harness 的酒馆启动器，安装、切换和管理独立的酒馆配置",
  "license": "MIT",
  "author": "2NF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flizzywine/dsh-tavern.git",
    "directory": "tavern-plugin/packages/dsh-profile-bridge"
  },
  "homepage": "https://github.com/flizzywine/dsh-tavern#readme",
  "bugs": {
    "url": "https://github.com/flizzywine/dsh-tavern/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "profile",
    "desktop"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
