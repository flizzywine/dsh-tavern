{
	"name": "dsh-dream-skin",
	"version": "9.23.0",
	"description": "DSH Tavern 全局界面皮肤：配色、壁纸、CSS 皮肤导入与管理。",
	"license": "MIT",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./client": {
			"types": "./lib/types/client/index.d.ts",
			"default": "./lib/client.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"docs/i18n",
		"docs/previews",
		"docs/screenshots",
		"docs/examples",
		"docs/themes-spec.md",
		"docs/design-philosophy.md",
		"fonts"
	],
	"author": "dsh-dream-skin contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RevolutionLA/dsh-dream-skin.git"
	},
	"bugs": {
		"url": "https://github.com/RevolutionLA/dsh-dream-skin/issues"
	},
	"homepage": "https://github.com/RevolutionLA/dsh-dream-skin#readme",
	"keywords": [
		"deepseek",
		"deepseek-harness",
		"dsh",
		"dsh-desktop",
		"dsh-plugin",
		"plugin",
		"theme",
		"skin",
		"wallpaper",
		"theme-pack",
		"glassmorphism",
		"web-ui",
		"换肤",
		"主题",
		"美化"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"test": "node --test tests/*.test.cjs"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-theme",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-settings-general"
			],
			"platform": "web",
			"immediately": true
		}
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0",
		"@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.3.0",
		"@deepseek-ai/dsh-client-store": "*",
		"@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.3.0",
		"@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.0-rc.6 <0.3.0",
		"@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.6 <0.3.0",
		"react": "^18.2.0"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/cordis": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-locale": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-runtime": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-store": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-settings": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-settings-general": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-theme": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
