{
  "name": "dsh-tavern-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./build": "./build.mjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "src",
    "build.mjs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-tavern-plugin"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check"
  }
}
