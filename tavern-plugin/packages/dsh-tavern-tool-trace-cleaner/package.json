{
  "name": "dsh-tavern-tool-trace-cleaner",
  "version": "1.0.0",
  "description": "DSH Tavern 独立插件：清理前台工具调用（读变量、使用 Skill、查世界书、召回历史）在上下文历史（L1）与正文文本（L2）中留下的痕迹。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "tavernApiVersion": 8
    }
  },
  "license": "MIT"
}
