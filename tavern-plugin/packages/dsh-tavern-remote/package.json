{
  "name": "dsh-tavern-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/shared.d.ts", "default": "./lib/types/shared.js" },
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": ["@deepseek-ai/dsh-api-gateway/client"],
      "inject": ["@deepseek-ai/dsh-api-gateway"]
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.host.json && node scripts/generate-typert.mjs && DSH_BUILD_FACE=host tsdown && tsc -p tsconfig.client.json && DSH_BUILD_FACE=client tsdown && node scripts/normalize-output.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "zod": "^4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-gateway": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
