{
  "name": "dsh-tavern-plot-compass",
  "version": "1.1.0",
  "description": "DSH Tavern 剧情罗盘插件：今期/中期/长期多路线分支推演、防剧透盲盒、脑暴策划对话、自动节拍核对、候选角标联动与一键分叉试玩。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "prompts",
    "client.js",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmalove/dsh-tavern-plot-compass.git"
  },
  "homepage": "https://github.com/bigmalove/dsh-tavern-plot-compass#readme",
  "bugs": {
    "url": "https://github.com/bigmalove/dsh-tavern-plot-compass/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-tavern-plugin"
      ]
    },
    "compatibility": {
      "tavernApiVersion": 8
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
