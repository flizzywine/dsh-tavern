{
  "name": "dsh-tavern-dshgo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "dsh-go 上的酒馆启动器：在 App 的原生面板里查看并切换酒馆 bundle，不改 profile、不碰 Desktop",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": { "zh": "酒馆启动器", "en": "Tavern launcher" },
    "icon": "play",
    "contributes": {
      "composer.strip": [
        { "id": "tavern-status", "icon": "play", "panel": "tavern" }
      ],
      "panels": [
        {
          "id": "tavern",
          "title": { "zh": "酒馆", "en": "Tavern" },
          "icon": "play",
          "placement": ["plugin", "features"]
        }
      ]
    }
  }
}
