    "extensions": {
      "regex_scripts": [
        {
          "id": "avra-tavern-status",
          "scriptName": "金麦穗酒馆状态面板",
          "findRegex": "/<avra_status>\\s*时间[：:]\\s*(.*?)\\r?\\n地点[：:]\\s*(.*?)\\r?\\n天气[：:]\\s*(.*?)\\r?\\n线索[：:]\\s*(.*?)\\r?\\n信任[：:]\\s*(\\d{1,3})\\s*\\r?\\n状态[：:]\\s*(.*?)\\s*<\\/avra_status>/s",
          "replaceString": "<style>\n.avra-panel{--gold:#e7c47b;--paper:#f3e8cf;position:relative;overflow:hidden;margin:18px 0;padding:20px 22px;border:1px solid rgba(231,196,123,.5);border-radius:18px;background:radial-gradient(circle at 88% 0%,rgba(171,72,47,.34),transparent 34%),linear-gradient(145deg,#241b1a,#12100f 72%);color:var(--paper);box-shadow:0 18px 45px rgba(8,5,4,.38);font-family:ui-serif,Georgia,'Noto Serif SC','Songti SC',serif}.avra-panel:before{content:'';position:absolute;inset:8px;border:1px solid rgba(231,196,123,.16);border-radius:12px;pointer-events:none}.avra-top{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding-bottom:15px;border-bottom:1px solid rgba(231,196,123,.28)}.avra-kicker{font:700 11px/1.2 system-ui,sans-serif;letter-spacing:.24em;color:var(--gold);text-transform:uppercase}.avra-title{margin-top:5px;font-size:25px;font-weight:700;letter-spacing:.08em}.avra-time{padding:7px 12px;border:1px solid rgba(231,196,123,.35);border-radius:999px;background:rgba(231,196,123,.08);color:#f7dfaa;font:600 13px/1.2 system-ui,sans-serif;white-space:nowrap}.avra-grid{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:14px}.avra-item{min-width:0;padding:10px 12px;border-radius:11px;background:rgba(255,255,255,.045)}.avra-label{display:block;margin-bottom:3px;color:#bcae98;font:600 10px/1.2 system-ui,sans-serif;letter-spacing:.14em}.avra-value{display:block;color:#fff5dc;font-size:14px;line-height:1.45;overflow-wrap:anywhere}.avra-trust{position:relative;margin-top:14px;padding-top:13px;border-top:1px solid rgba(231,196,123,.18)}.avra-trust-row{display:flex;justify-content:space-between;color:#d8c8ad;font:600 11px/1.2 system-ui,sans-serif}.avra-track{height:6px;margin-top:8px;overflow:hidden;border-radius:99px;background:#0b0908}.avra-fill{height:100%;width:$5%;border-radius:inherit;background:linear-gradient(90deg,#8f3f32,#e7c47b);box-shadow:0 0 12px rgba(231,196,123,.45)}.avra-state{position:relative;margin-top:13px;color:#d8c8ad;font-size:13px}.avra-state b{color:var(--gold);font-weight:600}@media(max-width:700px){.avra-grid{grid-template-columns:1fr}.avra-title{font-size:21px}}\n</style>\n<section class=\"avra-panel\" aria-label=\"金麦穗酒馆状态\">\n  <header class=\"avra-top\"><div><div class=\"avra-kicker\">The Golden Sheaf</div><div class=\"avra-title\">金麦穗酒馆</div></div><div class=\"avra-time\">$1</div></header>\n  <div class=\"avra-grid\"><div class=\"avra-item\"><span class=\"avra-label\">地点</span><span class=\"avra-value\">$2</span></div><div class=\"avra-item\"><span class=\"avra-label\">天气</span><span class=\"avra-value\">$3</span></div><div class=\"avra-item\"><span class=\"avra-label\">当前线索</span><span class=\"avra-value\">$4</span></div></div>\n  <div class=\"avra-trust\"><div class=\"avra-trust-row\"><span>阿芙拉的信任</span><span>$5 / 100</span></div><div class=\"avra-track\"><div class=\"avra-fill\"></div></div></div>\n  <div class=\"avra-state\"><b>人物状态</b> · $6</div>\n</section>",
          "trimStrings": [],
          "placement": [2],
          "disabled": false,
          "markdownOnly": true,
          "promptOnly": false,
          "runOnEdit": true,
          "minDepth": null,
          "maxDepth": null
        }
      ]
    }
