{
  "name": "dsh-profile-tavern",
  "version": "1.2.0",
  "private": true,
  "bin": {
    "dsh-tavern": "bin/dsh-tavern.mjs"
  },
  "scripts": {
    "build:image-gen": "pnpm --dir tavern-plugin/packages/dsh-image-gen run build",
    "test:image-gen": "pnpm --dir tavern-plugin/packages/dsh-image-gen test",
    "install:tavern": "node ./bin/dsh-tavern.mjs install",
    "start:tavern": "node ./bin/dsh-tavern.mjs start",
    "stop:tavern": "node ./bin/dsh-tavern.mjs stop",
    "restart:tavern": "node ./bin/dsh-tavern.mjs restart",
    "status:tavern": "node ./bin/dsh-tavern.mjs status",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "dsh-web-mobile": "2.3.0",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "chevrotain": "^11.2.0",
    "dsh-better-sidebar": "0.17.1",
    "dsh-tavern-plugin": "link:./tavern-plugin",
    "dsh-image-gen": "link:./tavern-plugin/packages/dsh-image-gen",
    "ejs": "3.1.9",
    "mathjs": "12.4.3",
    "quickjs-emscripten-core": "0.32.0",
    "yaml": "2.9.0"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-web-mobile",
        "dsh-better-sidebar",
        "dsh-tavern-plugin",
        "dsh-image-gen"
      ]
    }
  }
}
