{
  "format": "dsh-tavern-mod",
  "schemaVersion": 5,
  "id": "dsh.performance",
  "name": "Performance",
  "packageName": "dsh-tavern-mod-performance",
  "version": "2.0.0",
  "hostApi": ">=1.0.0 <2.0.0",
  "dependencies": [
    {
      "id": "dsh.timer",
      "range": "^2.0.0",
      "optional": true,
      "onMissing": "notify",
      "operations": [
        "start",
        "resume",
        "release",
        "read",
        "phase"
      ]
    }
  ],
  "config": {
    "version": 1,
    "schema": {
      "type": "object",
      "properties": {
        "defaultTopicSeconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 86400
        }
      },
      "required": [
        "defaultTopicSeconds"
      ],
      "additionalProperties": false
    },
    "defaults": {
      "defaultTopicSeconds": 60
    }
  },
  "preferences": {
    "schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "defaults": {}
  },
  "dataVersion": 1,
  "assetKinds": [
    {
      "id": "dsh.performance/performance",
      "schemaVersion": 1,
      "directorSelectable": true,
      "schema": {
        "type": "object"
      },
      "label": "演出"
    }
  ],
  "coreAssets": [],
  "permissions": [
    "stage.state",
    "stage.presentation"
  ],
  "performances": [],
  "entry": "plugin.mjs",
  "summary": "按剧情节拍播放演出，可配合倒计时进行辩论。",
  "commandPrompts": [
    {
      "id": "performance-rule",
      "path": "prompts/performance.txt",
      "placement": {
        "section": "director.rules.presentation",
        "order": 40
      }
    }
  ],
  "commands": [
    {
      "id": "set",
      "op": "mod.dsh.performance.set",
      "mode": "adds",
      "dsl": {
        "verb": "performance-set",
        "syntax": "mod.dsh.performance.set {ref,level?}"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object",
            "properties": {
              "packId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              },
              "kind": {
                "type": "string",
                "enum": [
                  "performances"
                ]
              },
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "packId",
              "kind",
              "assetId"
            ],
            "additionalProperties": false
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sec": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 86400
          },
          "level": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      },
      "persistence": "state",
      "handler": "command",
      "promptId": "performance-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 40
      },
      "caps": {
        "perTurn": 8,
        "bytes": 2048
      }
    },
    {
      "id": "off",
      "op": "mod.dsh.performance.off",
      "mode": "adds",
      "dsl": {
        "verb": "performance-off",
        "syntax": "mod.dsh.performance.off {}"
      },
      "paramsStyle": "flat",
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "persistence": "state",
      "handler": "command",
      "promptId": "performance-rule",
      "placement": {
        "section": "director.commands.presentation",
        "order": 40
      },
      "caps": {
        "perTurn": 8,
        "bytes": 2048
      }
    }
  ],
  "admission": {
    "entryKinds": [
      "performances"
    ]
  }
}
