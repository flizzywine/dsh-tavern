    }
  ],
  "coreAssets": [],
  "permissions": [
    "stage.state",
    "stage.presentation"
  ],
  "performances": [],
  "entry": "plugin.mjs",
  "summary": "\u6309\u5267\u60c5\u8282\u62cd\u64ad\u653e\u6f14\u51fa\uff0c\u53ef\u914d\u5408\u5012\u8ba1\u65f6\u8fdb\u884c\u8fa9\u8bba\u3002"
